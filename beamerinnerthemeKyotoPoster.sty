\ProvidesPackage{beamerinnerthemeKyotoPoster}[2026-09-24 v1.0 Kyoto poster inner theme]

%% Reuse the presentation theme's block/list visual language, then override
%% fixed-point list spacing with font-relative spacing suitable for posters.
\RequirePackage{beamerinnerthemeKyoto}

\mode<presentation>
  \g@addto@macro\@listi{%
    \setlength\itemsep{.55em plus .12em minus .08em}%
    \setlength\parsep{.20em plus .05em}%
  }
  \let\@listI\@listi
  \g@addto@macro\@listii{%
    \setlength\itemsep{.45em plus .10em minus .06em}%
    \setlength\parsep{.16em plus .04em}%
  }
  \g@addto@macro\@listiii{%
    \setlength\itemsep{.40em plus .08em minus .05em}%
    \setlength\parsep{.14em plus .04em}%
  }
\mode<all>

\endinput
