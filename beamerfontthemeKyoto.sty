%% ------------------------------------------------------------------------
%% Font theme of the Kyoto presentation theme.
%%
%% Font-family selection is shared with KyotoPoster via kyotofonts.sty.
%% This file therefore contains only presentation-specific element sizes
%% and Beamer font-role configuration.
%% ------------------------------------------------------------------------
\ProvidesPackage{beamerfontthemeKyoto}[2026-09-24 v1.2 Kyoto font theme]

\RequirePackage{kyotofonts}

%% ------------------------------------------------------------------
%% Element sizes (visually-equivalent Beamer 16:9 values, leading ~1.4).
%% Exposed as size-macros so templates can selectfont them directly.
%% ------------------------------------------------------------------
\newcommand\kyoto@l@title{\kyoto@titlefamily\fontsize{26.5pt}{35pt}\selectfont}
\newcommand\kyoto@l@frametitle{\kyoto@titlefamily\fontsize{22.7pt}{30pt}\selectfont}
\newcommand\kyoto@l@section{\kyoto@titlefamily\fontsize{30pt}{40pt}\selectfont}
\newcommand\kyoto@l@author{\fontsize{15pt}{20pt}\selectfont}
\newcommand\kyoto@l@institute{\fontsize{11.3pt}{15pt}\selectfont}
\newcommand\kyoto@l@date{\fontsize{12.6pt}{16.5pt}\selectfont}
\newcommand\kyoto@l@footer{\fontsize{8.8pt}{11.5pt}\selectfont}
\newcommand\kyoto@l@footnote{\fontsize{7.6pt}{9.9pt}\selectfont}

\mode<presentation>
  %% Expose the condensed display family through Beamer's public font role.
  \setbeamerfont{frametitle}{family=\kyoto@titlefamily}

  %% Body text at 12pt, with the standard 12pt/14.5pt leading.
  \renewcommand\normalsize{\fontsize{12pt}{14.5pt}\selectfont}
  \renewcommand\footnotesize{\kyoto@l@footnote}
  \setbeamerfont{footnote}{size=\footnotesize}

  %% Do not shrink nested list levels.
  \setbeamerfont{itemize/enumerate subbody}{size=\normalsize}
  \setbeamerfont{itemize/enumerate subsubbody}{size=\normalsize}
\mode<all>

\endinput
