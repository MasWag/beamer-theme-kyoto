%% ------------------------------------------------------------------------
%% Kyoto poster theme for Beamer + beamerposter.
%%
%% Recommended usage:
%%
%%   \documentclass[final]{beamer}
%%   \usepackage[size=a0,orientation=portrait,scale=1.0]{beamerposter}
%%   \usetheme{KyotoPoster}
%% ------------------------------------------------------------------------
\ProvidesPackage{beamerthemeKyotoPoster}[2026-09-24 v1.5 Kyoto poster theme]

\RequirePackage{etoolbox}

\@ifpackageloaded{beamerposter}{}{%
  \PackageWarning{beamerthemeKyotoPoster}{%
    KyotoPoster is designed for beamerposter; load beamerposter before \string\usetheme}%
}

\beamer@centeredfalse
\mode<presentation>
  \usefonttheme{KyotoPoster}
  \usecolortheme{Kyoto}
  \useinnertheme{KyotoPoster}
  \useoutertheme{KyotoPoster}
  \setbeamerfont{alerted text}{series=\bfseries}
\mode<all>

%% Same emphasis convention as the presentation theme.
\renewcommand\emph[1]{\textcolor{KyotoEmph}{\textbf{#1}}}

%% A full-bleed poster section ribbon.  Beamer's colorbox implementation
%% automatically compensates for the frame's left/right text margins when
%% wd is wider than \textwidth.  The ribbon background therefore reaches
%% both physical page edges.  The title itself is placed in a fixed-height
%% vbox with flexible space above and below, so it is vertically centered.
\newcommand\kyotopostersection[1]{%
  \par\medskip
  \begingroup
    \usebeamerfont{poster section}%
    \dimen@=1.35\baselineskip
    \begin{beamercolorbox}[wd=\paperwidth,sep=0pt]{poster section}%
      \vbox to \dimen@{%
        \vfil
        \hbox to \paperwidth{%
          \hskip\kyotopostercontentmargin
          \strut #1%
          \hfil
          \hskip\kyotopostercontentmargin
        }%
        \vfil
      }%
    \end{beamercolorbox}%
  \endgroup
  \smallskip
}


%% A column-local section ribbon for layouts in which the left and right
%% halves advance through sections independently.  Unlike
%% \kyotopostersection, this ribbon is intentionally limited to the current
%% \linewidth.
\newcommand\kyotopostercolumnsection[1]{%
  \par\medskip
  \begingroup
    \usebeamerfont{poster section}%
    \dimen@=1.35\baselineskip
    \begin{beamercolorbox}[wd=\linewidth,sep=0pt]{poster section}%
      \vbox to \dimen@{%
        \vfil
        \hbox to \linewidth{%
          \hskip.45em
          \strut #1%
          \hfil
          \hskip.45em
        }%
        \vfil
      }%
    \end{beamercolorbox}%
  \endgroup
  \smallskip
}

%% Independent two-column layout.  The left/right child environments capture
%% their bodies as token lists; the parent typesets those token lists into
%% top-aligned minipages only after both have been collected.  This avoids
%% the savebox/lrbox grouping problem that can discard the collected content.
%%
%% In the unstarred environment, a running \vrule separates the columns and
%% a matching thin rule closes the pair at the bottom, reproducing the
%% T-shaped divider used by the RV poster.  The starred environment keeps the
%% same 49%/49% geometry but omits both rules.
\newtoks\kyotoposter@leftcolumntoks
\newtoks\kyotoposter@rightcolumntoks
\newsavebox\kyotoposter@leftcolumnbox
\newsavebox\kyotoposter@rightcolumnbox
\newlength\kyotoposter@columnwidth
\newif\ifkyotoposter@columnseparator

\newcommand\kyotoposter@twocolumnsbegin[1]{%
  \par\begingroup
  \ifstrequal{#1}{true}{%
    \kyotoposter@columnseparatortrue
  }{%
    \kyotoposter@columnseparatorfalse
  }%
  \setlength\kyotoposter@columnwidth{.49\linewidth}%
  \global\kyotoposter@leftcolumntoks={}%
  \global\kyotoposter@rightcolumntoks={}%
}

\newcommand\kyotoposter@typesetcolumn[2]{%
  \sbox#1{%
    \begin{minipage}[t]{\kyotoposter@columnwidth}%
      \vspace*{0pt}%
      #2%
    \end{minipage}%
  }%
}

\newcommand\kyotoposter@twocolumnsend{%
  \kyotoposter@typesetcolumn{\kyotoposter@leftcolumnbox}{%
    \the\kyotoposter@leftcolumntoks
  }%
  \kyotoposter@typesetcolumn{\kyotoposter@rightcolumnbox}{%
    \the\kyotoposter@rightcolumntoks
  }%
  \par\noindent
  \vbox{%
    \hbox to \linewidth{%
      \usebox\kyotoposter@leftcolumnbox
      \hfil
      \ifkyotoposter@columnseparator
        {\color{KyotoFg}\vrule width .06em}%
      \fi
      \hfil
      \usebox\kyotoposter@rightcolumnbox
    }%
    \ifkyotoposter@columnseparator
      \nointerlineskip
      {\color{KyotoFg}\hrule height .06em width \linewidth}%
    \fi
  }%
  \par\endgroup
}

\newenvironment{kyotopostertwocolumns}{%
  \kyotoposter@twocolumnsbegin{true}%
}{%
  \kyotoposter@twocolumnsend
}

\newenvironment{kyotopostertwocolumns*}{%
  \kyotoposter@twocolumnsbegin{false}%
}{%
  \kyotoposter@twocolumnsend
}

\NewDocumentEnvironment{kyotoposterleftcolumn}{+b}{%
  \global\kyotoposter@leftcolumntoks={#1}%
}{}

\NewDocumentEnvironment{kyotoposterrightcolumn}{+b}{%
  \global\kyotoposter@rightcolumntoks={#1}%
}{}

\AtBeginDocument{%
  \hypersetup{%
    linkcolor = KyotoLink,
    urlcolor  = KyotoLink,
    citecolor = KyotoLink,
  }%
}

\endinput
