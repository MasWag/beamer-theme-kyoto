\ProvidesPackage{beamerfontthemeKyotoPoster}[2026-09-24 v1.2 Kyoto poster font theme]

\RequirePackage{kyotofonts}

%% beamerposter normally provides these extra size commands.  The fallbacks
%% keep the theme usable enough to emit a helpful warning if beamerposter
%% was accidentally omitted.
\providecommand\veryHuge{\huge}
\providecommand\VeryHuge{\Huge}
\providecommand\VERYHuge{\Huge}

\mode<presentation>
  %% Keep the A0 hierarchy close to the reference poster:
  %% title ~89pt, author/affiliation/major section ~62pt, block title
  %% ~43pt, body ~30pt at beamerposter scale=1.0.
  %%
  %% The old poster's ordinary body text is typically about 29--31pt.
  %% beamerposter's \normalsize is only about 25pt here, so use \large
  %% for body roles instead.
  \setbeamerfont{normal text}{size=\large}

  \setbeamerfont{poster title}{
    family=\kyoto@titlefamily,
    size=\VeryHuge,
    series=\bfseries
  }
  \setbeamerfont{poster author}{size=\Huge,series=\bfseries}
  \setbeamerfont{poster institute}{size=\Huge}
  \setbeamerfont{poster date}{size=\large}
  \setbeamerfont{poster section}{
    family=\kyoto@titlefamily,
    size=\Huge,
    series=\bfseries
  }

  \setbeamerfont{block title}{
    family=\kyoto@titlefamily,
    size=\LARGE,
    series=\bfseries
  }
  \setbeamerfont{block body}{size=\large}
  \setbeamerfont{block title alerted}{
    family=\kyoto@titlefamily,
    size=\LARGE,
    series=\bfseries
  }
  \setbeamerfont{block body alerted}{size=\large}
  \setbeamerfont{block title example}{
    family=\kyoto@titlefamily,
    size=\LARGE,
    series=\bfseries
  }
  \setbeamerfont{block body example}{size=\large}

  %% Do not shrink nested poster lists below the body size.
  \setbeamerfont{itemize/enumerate body}{size=\large}
  \setbeamerfont{itemize/enumerate subbody}{size=\large}
  \setbeamerfont{itemize/enumerate subsubbody}{size=\large}
\mode<all>

\endinput
