%% ------------------------------------------------------------------------
%% Kyoto theme for Beamer.
%%
%% Recommended usage (reference engine: LuaLaTeX):
%%
%%   \documentclass[aspectratio=169]{beamer}
%%   \usetheme{Kyoto}
%%
%% Theme options (after the class, i.e. \usetheme[<opt>,...]{Kyoto}):
%%
%%   totalpagenum = true|false      (default: true)
%%       Show "frame/total" in the footer when on, or only the frame
%%       number when off.
%%   rightfooter  = <text>
%%       Text shown at the right edge of the footer.  The default is
%%       `\insertshortauthor'.  (Prefer the command below for text that
%%       contains spaces.)
%%
%% In-document commands:
%%
%%   \kyotototalpagenum{true|false}   toggle the "frame/total" footer
%%   \kyotofooter{<text>}             set the right-hand footer text
%% ------------------------------------------------------------------------
\ProvidesPackage{beamerthemeKyoto}[2026-09-24 v1.1 Kyoto Beamer theme]

%% ------------------------------------------------------------------
%% Dependencies
%% ------------------------------------------------------------------
\RequirePackage{etoolbox}
\RequirePackage{kvoptions}

%% ------------------------------------------------------------------
%% Options: \usetheme[totalpagenum=true|false,rightfooter=<text>]{Kyoto}
%% ------------------------------------------------------------------
\SetupKeyvalOptions{family=kyoto,prefix=kyoto@}
\DeclareBoolOption[true]{totalpagenum}
\DeclareStringOption[\insertshortauthor]{rightfooter}
\ProcessKeyvalOptions*
\let\kyoto@footer@right\kyoto@rightfooter

%% Public overrides.
\newcommand\kyotototalpagenum[1]{%
  \ifstrequal{#1}{false}{\global\kyoto@totalpagenumfalse}{%
  \ifstrequal{#1}{off}{\global\kyoto@totalpagenumfalse}{%
  \ifstrequal{#1}{no}{\global\kyoto@totalpagenumfalse}{%
    \global\kyoto@totalpagenumtrue}}}%
}
\newcommand\kyotofooter[1]{\gdef\kyoto@footer@right{#1}}

%% ------------------------------------------------------------------
%% The theme
%% ------------------------------------------------------------------
\beamer@centeredfalse
\mode<presentation>
  \usefonttheme{Kyoto}
  \usecolortheme{Kyoto}
  \useinnertheme{Kyoto}
  \useoutertheme{Kyoto}
  \setbeamerfont{alerted text}{series=\bfseries}
\mode<all>

%% \emph -> bold + emphasis color, rather than the usual italics.
\renewcommand\emph[1]{\textcolor{KyotoEmph}{\textbf{#1}}}

%% Hyperlinks (internal / url / citation) use the navy-blue link color.
\AtBeginDocument{%
  \hypersetup{%
    linkcolor = KyotoLink,
    urlcolor  = KyotoLink,
    citecolor = KyotoLink,
  }%
}

\endinput
